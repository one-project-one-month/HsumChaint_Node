meta {
  name: Login (SuperAdmin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "09999999999",
    "password": "password123"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.accessToken) {
    bru.setEnvVar("token", res.body.data.accessToken);
  }
}

