generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "role_name_unique") @db.VarChar(50)
  isDeleted       Boolean           @default(false) @map("is_deleted")
  
  users           User[]
  rolePermissions RolePermission[]
  
  @@map("Role")
}

model Permission {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "permission_name_unique") @db.VarChar(50)
  isDeleted       Boolean           @default(false) @map("is_deleted")
  
  rolePermissions RolePermission[]
  
  @@map("Permission")
}

model RolePermission {
  id            Int         @id @default(autoincrement())
  roleId        Int         @map("role_id")
  permissionId  Int         @map("permission_id")
  isDeleted     Boolean     @default(false) @map("is_deleted")
  
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId], map: "UX_Role_Permission_role_permission")
  @@index([roleId], map: "IX_Role_Permission_role_id")
  @@index([permissionId], map: "IX_Role_Permission_permission_id")
  @@map("Role_Permission")
}

model SpaceRole {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique(map: "space_role_name_unique") @db.VarChar(50)
  description String?                @db.VarChar(255)
  isDeleted   Boolean                @default(false) @map("is_deleted")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  members     MonasteryMember[]
  invitations Invitation[]
  permissions SpaceRolePermission[]

  @@map("Space_Role")
}

model SpacePermission {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique(map: "space_permission_name_unique") @db.VarChar(100)
  description String?                @db.VarChar(255)
  isDeleted   Boolean                @default(false) @map("is_deleted")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  spaceRoles  SpaceRolePermission[]

  @@map("Space_Permission")
}

model SpaceRolePermission {
  id                Int             @id @default(autoincrement())
  spaceRoleId       Int             @map("space_role_id")
  spacePermissionId Int             @map("space_permission_id")
  isDeleted         Boolean         @default(false) @map("is_deleted")

  spaceRole         SpaceRole       @relation(fields: [spaceRoleId], references: [id], onDelete: Cascade)
  spacePermission   SpacePermission @relation(fields: [spacePermissionId], references: [id], onDelete: Cascade)

  @@unique([spaceRoleId, spacePermissionId], map: "UX_Space_Role_Permission")
  @@index([spaceRoleId], map: "IX_Space_Role_Permission_role_id")
  @@index([spacePermissionId], map: "IX_Space_Role_Permission_permission_id")
  @@map("Space_Role_Permission")
}
model LoginMode {
  id                       Int      @id @default(autoincrement())
  code                     String   @unique(map: "UX_Login_Mode_code") @db.VarChar(30)
  displayName              String   @map("display_name") @db.VarChar(100)
  isActive                 Boolean  @default(false) @map("is_active")
  requirePhoneVerification Boolean  @default(false) @map("require_phone_verification")
  requireEmailVerification Boolean  @default(false) @map("require_email_verification")
  updatedById              Int?     @map("updated_by_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  updatedBy                User?    @relation("LoginModeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive], map: "IX_Login_Mode_is_active")
  @@index([updatedById], map: "IX_Login_Mode_updated_by_id")
  @@map("Login_Mode")
}

model OtpCode {
  id                 BigInt    @id
  userId             Int?      @map("user_id")
  channel            String    @db.VarChar(20)
  purpose            String    @db.VarChar(30)
  destination        String    @db.VarChar(255)
  codeHash           String    @map("code_hash") @db.VarChar(255)
  expiresAt          DateTime  @map("expires_at")
  isUsed             Boolean   @default(false) @map("is_used")
  usedAt             DateTime? @map("used_at")
  revokedAt          DateTime? @map("revoked_at")
  failedAttemptCount Int       @default(0) @map("failed_attempt_count")
  maxAttemptCount    Int       @default(5) @map("max_attempt_count")
  createdAt          DateTime  @default(now()) @map("created_at")

  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "IX_Otp_Code_user_id")
  @@index([destination, channel, purpose, createdAt], map: "IX_Otp_Code_lookup")
  @@index([expiresAt], map: "IX_Otp_Code_expires_at")
  @@index([usedAt, expiresAt, revokedAt], map: "IX_Otp_Code_cleanup")
  @@map("Otp_Code")
}

model User {
  id            Int       @id @default(autoincrement())
  roleId        Int       @map("role_id")
  name          String    @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  password      String    @db.VarChar(255)
  email         String?   @db.VarChar(255)
  contactPhone  String?   @map("contact_phone") @db.VarChar(191)
  fcmToken      String?   @map("fcm_token") @db.VarChar(255)
  avatar        String?
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  
  monkProfile         MonkProfile?
  monasterySpaces     MonasterySpace[]  @relation("SpaceCreator")
  monasteryMembers    MonasteryMember[]
  donorLists          DonorList[]       @relation("DonorUser")
  reviewedDonations   DonorList[]       @relation("ReviewerUser")
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  userSetting         UserSetting?
  invitationsSent     Invitation[]      @relation("InvitedByUser")
  invitationsReceived Invitation[]      @relation("InvitedUser")
  passwordResetTokens PasswordResetToken[]
  otpCodes            OtpCode[]
  updatedLoginModes   LoginMode[]       @relation("LoginModeUpdatedBy")
  
  @@unique([phone, isDeleted], map: "UX_User_phone_active")
  @@unique([email, isDeleted], map: "UX_User_email_active")
  @@index([roleId], map: "IX_User_role_id")
  @@index([isDeleted, roleId, createdAt(sort: Desc)], map: "users_is_deleted_user_type_created_at_idx")
  @@index([name], map: "users_username_idx")
  @@index([contactPhone], map: "users_contactPhone_idx")
  @@map("users")
}

model MonkProfile {
  id               Int    @id @default(autoincrement())
  userId           Int    @unique @map("user_id")
  monasteryName    String @map("monastery_name") @db.VarChar(255)
  monasteryAddress String @map("monastery_address") @db.VarChar(500)
  
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([monasteryName])
  @@index([monasteryAddress])
  @@map("monk_profile")
}

model MonasterySpace {
  id              Int      @id @default(autoincrement())
  monasteryName   String   @map("monastery_name") @db.VarChar(255)
  description     String?  @db.VarChar(1000)
  address         String?  @db.VarChar(500)
  createdById     Int?     @map("created_by_id")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  
  createdBy       User?    @relation("SpaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  members         MonasteryMember[]
  donorLists      DonorList[]
  invitations     Invitation[]
  
  @@index([createdById], map: "IX_Monastery_Space_created_by_id")
  @@index([isDeleted], map: "monastery_space_is_deleted_idx")
  @@map("Monastery_Space")
}

model MonasteryMember {
  id               Int            @id @default(autoincrement())
  userId           Int            @map("user_id")
  monasterySpaceId Int            @map("monastery_space_id")
  spaceRoleId      Int            @map("space_role_id")
  isOwner          Boolean        @default(false) @map("is_owner")
  
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monasterySpace   MonasterySpace @relation(fields: [monasterySpaceId], references: [id], onDelete: Cascade)
  spaceRole        SpaceRole      @relation(fields: [spaceRoleId], references: [id], onDelete: Restrict)
  
  @@unique([userId, monasterySpaceId], map: "UX_Monastery_Member_user_space")
  @@index([monasterySpaceId], map: "IX_Monastery_Member_monastery_space_id")
  @@index([spaceRoleId], map: "IX_Monastery_Member_space_role_id")
  @@map("Monastery_Member")
}

model DonorList {
  id                  Int       @id @default(autoincrement())
  monasterySpaceId    Int       @map("monastery_space_id")
  donorId             Int?      @map("donor_id")
  donorName           String?   @map("donor_name") @db.VarChar(255)
  donationType        String?   @map("donation_type") @db.VarChar(100)
  donationTypeValue   Int       @default(0) @map("donation_type_value")
  customDonationType  String?   @map("custom_donation_type") @db.VarChar(255)
  note                String?   @db.VarChar(1000)
  amount              Decimal?  @db.Decimal(18, 2)
  quantity            Decimal?  @db.Decimal(18, 2)
  status              String?   @db.VarChar(100)
  statusValue         Int       @default(2) @map("status_value")
  reviewerId          Int?      @map("reviewer_id")
  
  createdAt           DateTime  @default(now()) @map("created_at")
  reviewedAt          DateTime? @map("reviewed_at")
  pickupTime          DateTime? @map("pickup_time")
  dropoffTime         DateTime? @map("dropoff_time")
  completedAt         DateTime? @map("completed_at")
  
  monasterySpace      MonasterySpace @relation(fields: [monasterySpaceId], references: [id])
  donor               User?          @relation("DonorUser", fields: [donorId], references: [id], onDelete: Restrict)
  reviewer            User?          @relation("ReviewerUser", fields: [reviewerId], references: [id])
  
  @@index([monasterySpaceId], map: "IX_Donor_List_monastery_space_id")
  @@index([donorId], map: "IX_Donor_List_donor_id")
  @@index([reviewerId], map: "IX_Donor_List_reviewer_id")
  @@index([statusValue, createdAt], map: "IX_Donor_List_status_created_at")
  @@map("Donor_List")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        Int      @default(2)
  message     String?  @db.VarChar(1000)
  isRead      Boolean  @default(false) @map("is_read")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt], map: "IX_Notification_user_id_created_at")
  @@map("Notification")
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  refreshToken String    @unique @map("refresh_token") @db.VarChar(512)
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([refreshToken, userId, revokedAt])
  @@index([userId], map: "refresh_tokens_user_id_fkey")
  @@map("refresh_tokens")
}

model Invitation {
  id               Int            @id @default(autoincrement())
  monasterySpaceId Int            @map("monastery_space_id")
  invitedUserId    Int            @map("invited_user_id")
  invitedById      Int?           @map("invited_by_id")
  spaceRoleId      Int            @default(4) @map("space_role_id")
  status           Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at")
  
  monasterySpace   MonasterySpace @relation(fields: [monasterySpaceId], references: [id], onDelete: Cascade)
  invitedUser      User           @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy        User?          @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull)
  spaceRole        SpaceRole      @relation(fields: [spaceRoleId], references: [id], onDelete: Restrict)
  
  @@index([monasterySpaceId], map: "IX_Invitation_monastery_space_id")
  @@index([invitedUserId], map: "IX_Invitation_invited_user_id")
  @@index([invitedById], map: "IX_Invitation_invited_by_id")
  @@index([spaceRoleId], map: "IX_Invitation_space_role_id")
  @@map("Invitation")
}

model UserSetting {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @unique @map("user_id")
  pickupTime              DateTime? @map("pickup_time")
  dropoffTime             DateTime? @map("dropoff_time")
  pickupNotificationTime  DateTime? @map("pickup_notification_time")
  dropoffNotificationTime DateTime? @map("dropoff_notification_time")
  
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("User_Setting")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  resetToken String   @unique @map("reset_token")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_fkey")
  @@map("password_reset_tokens")
}

model Donor {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String
  phoneNo            String              @map("phone_no")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  donationListDonors DonationListDonor[]

  @@unique([id, name])
  @@index([name, email])
  @@index([phoneNo])
  @@index([email])
  @@map("donors")
}

model DonationList {
  id             Int                 @id @default(autoincrement())
  title          String
  description    String?             @map("description")
  address        String?             @map("address")
  status         DonationStatus      @default(Pending)
  donationDate   DateTime            @map("donation_due_date")
  recurrence     DonationRecurrence  @default(OneTime)
  addReminder    Boolean             @default(false) @map("add_reminder")
  createdDate    DateTime            @map("created_date")
  updatedDate    DateTime?           @map("update_at")
  donationTypeId Int                 @map("donation_type_id")
  donors         DonationListDonor[]
  donationType   DonationType        @relation(fields: [donationTypeId], references: [id])

  @@index([donationTypeId])
  @@index([status])
  @@map("donation_lists")
}

model DonationListDonor {
  id             Int          @id @default(autoincrement())
  donationListId Int          @map("donation_list_id")
  donorId        Int          @map("donor_id")
  donationList   DonationList @relation(fields: [donationListId], references: [id])
  donor          Donor        @relation(fields: [donorId], references: [id])

  @@index([donationListId])
  @@index([donorId])
  @@map("donation_list_donors")
}

model DonationType {
  id           Int              @id @default(autoincrement())
  donationType DonationTypeName @map("donation_type")
  duration     Int
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  donationList DonationList[]

  @@index([donationType])
  @@map("donation_types")
}


enum DonationStatus {
  Pending
  Confirmed
  Completed
  Cancelled
}

enum DonationRecurrence {
  OneTime
  Weekly
  Monthly
}

enum DonationTypeName {
  Breakfast
  Lunch
  Dinner
}
